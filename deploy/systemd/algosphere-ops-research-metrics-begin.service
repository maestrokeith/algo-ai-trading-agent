[Unit]
Description=AlgoSphere begin-day research metrics capture

[Service]
Type=oneshot
WorkingDirectory=/opt/algosphere/algo-ai-trading-agent
Environment=PYTHONPATH=/opt/algosphere/algo-ai-trading-agent
ExecStart=/opt/algosphere/algo-ai-trading-agent/bin/algo capture-metrics --begin-day --live
User=algosphere
Group=algosphere

# Read-only analytics capture.
NoNewPrivileges=true
