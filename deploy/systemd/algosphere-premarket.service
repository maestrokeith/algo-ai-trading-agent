[Unit]
Description=AlgoSphere premarket intelligence refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/algosphere/algo-ai-trading-agent
EnvironmentFile=/etc/algo.env
Environment=PYTHONPATH=/opt/algosphere/algo-ai-trading-agent
ExecStart=/usr/bin/python3 /opt/algosphere/algo-ai-trading-agent/scripts/run_premarket_collection.py
User=algosphere
Group=algosphere

# Keep this service read-only with respect to trading. The script forces
# premarket_intelligence.allow_trading=false and only refreshes local artifacts.
NoNewPrivileges=true
