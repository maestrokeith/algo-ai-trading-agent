[Unit]
Description=AlgoSphere post-market catalyst and profitability analytics

[Service]
Type=oneshot
WorkingDirectory=/opt/algosphere/algo-ai-trading-agent
Environment=PYTHONPATH=/opt/algosphere/algo-ai-trading-agent
ExecStart=/usr/bin/python3 /opt/algosphere/algo-ai-trading-agent/scripts/run_ops_workflow.py postmarket-analytics --user live_bot
User=algosphere
Group=algosphere

# Read-only analytics except for report artifact generation.
NoNewPrivileges=true
