[Unit]
Description=AlgoSphere weekly research feedback report

[Service]
Type=oneshot
WorkingDirectory=/opt/algosphere/algo-ai-trading-agent
Environment=PYTHONPATH=/opt/algosphere/algo-ai-trading-agent
ExecStart=/usr/bin/python3 /opt/algosphere/algo-ai-trading-agent/scripts/run_ops_workflow.py weekly-research-feedback --user live_bot
User=algosphere
Group=algosphere

# Read-only weekly research analytics. Does not modify strategy config or trading behavior.
NoNewPrivileges=true
