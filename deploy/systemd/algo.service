[Unit]
Description=AlgoSphere live trading loop
Documentation=file:/opt/algosphere/algo-ai-trading-agent/docs/OPERATIONS.md
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=/opt/algosphere/algo-ai-trading-agent
Environment=PYTHONPATH=/opt/algosphere/algo-ai-trading-agent
EnvironmentFile=-/etc/algo.env
ExecStart=/usr/bin/python3.12 /opt/algosphere/algo-ai-trading-agent/scripts/algo_loop.py --live
User=algosphere
Group=algosphere
KillSignal=SIGTERM
TimeoutStopSec=90

# Restart only unexpected failures. The live loop may stop intentionally outside
# market hours, so Restart=always would mask an intentional clean exit.
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
PrivateTmp=false

[Install]
WantedBy=multi-user.target
